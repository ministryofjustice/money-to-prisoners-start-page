# This image is used for local development only
# see `docker compose` documentation in money-to-prisoners-common
# vim: ft=dockerfile

FROM ghcr.io/ministryofjustice/money-to-prisoners-start-page:latest

# Need to escalate to root to install packages
USER root

# Having a text editor in a dev container is super useful
# Also sudo is needed to install anything further as mtp user
#
# Deliberately best-effort: Docker Desktop's DNS frequently cannot resolve
# dl-cdn.alpinelinux.org (other hosts on the same container resolve fine), and these are a
# convenience rather than something the app needs. Failing hard here took down the whole of
# `docker-compose up`, because compose builds every service before starting any of them.
RUN apk add \
  vim \
  sudo \
  || echo 'WARNING: could not install vim/sudo; continuing without them'

# Only app/ goes into /app, as in the production Dockerfile: copying the whole repository put the
# source at /app/app/app.py, so Flask kept serving the published image's code
COPY --chown=mtp:mtp app /app/

# Revert back to settings under which the app should run
USER mtp

# Reload when the code changes; docker-compose in money-to-prisoners-common mounts app/ over /app.
# These are appended to the image's `flask run` entrypoint. Not FLASK_DEBUG, which would also
# turn on the interactive debugger on a port that compose publishes to the network.
CMD ["--reload", "--no-debugger"]
